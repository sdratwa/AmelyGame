MULTIPLAYER_PORT=2567
# W .env.local klienta: IP komputera uruchamiającego serwer, nie localhost drugiego komputera.
NEXT_PUBLIC_MULTIPLAYER_URL=ws://192.168.1.10:2567

# W .env.local: host strony dopuszczony przez Next dev (bez protokołu i portu).
# Dostosuj do IP komputera hosta; wiele hostów można oddzielić przecinkami.
ALLOWED_DEV_ORIGINS=192.168.1.10
